{
	"name": "itx/csv-editor",
	"description": "TYPO3 backend CSV editor for filelist integration",
	"type": "typo3-cms-extension",
	"license": "GPL-3.0-or-later",
	"homepage": "https://www.itx.de",
	"authors": [
		{
			"name": "itx informationssysteme gmbh",
			"email": "support@itx.de",
			"role": "Developer"
		}
	],
	"support": {
		"email": "support@itx.de",
		"issues": "https://github.com/itx-informationssysteme/csv-editor/issues"
	},
	"require": {
		"typo3/cms-core": "^14.3",
		"typo3/cms-backend": "^14.3",
		"typo3/cms-filelist": "^14.3"
	},
	"autoload": {
		"psr-4": {
			"Itx\\CsvEditor\\": "Classes/"
		}
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "csv_editor"
		}
	}
}
